@page "/clients/create"
@using System.ComponentModel.DataAnnotations

<h3>Create Client</h3>

<EditForm Model="@client" OnValidSubmit="CreateClient">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Name</label>
        <InputText class="form-control" @bind-Value="client.Name" />
        <ValidationMessage For="@(() => client.Name)" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="client.Email" />
        <ValidationMessage For="@(() => client.Email)" />
    </div>

    <div class="mb-3">
        <label>Company</label>
        <InputText class="form-control" @bind-Value="client.Company" />
    </div>

    <button type="submit" class="btn btn-primary">Create Client</button>
</EditForm>

@if (isCreated)
{
    <div class="alert alert-success mt-3">
        Client created successfully!
    </div>
}

@code {
    private ClientModel client = new();
    private bool isCreated;

    private void CreateClient()
    {
        isCreated = true;
        client = new ClientModel();
    }

    public class ClientModel
    {
        [Required(ErrorMessage = "Name is required.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Enter a valid email address.")]
        public string Email { get; set; } = "";

        public string Company { get; set; } = "";
    }
}